# ─── Secrets ─────────────────────────────────────────────────────────────────
# Never commit env files, keys, credentials or DB dumps.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
secrets/
*.secret
*.secrets.*

# Database dumps and backups
*.sql
# …except Prisma's migrations, which are schema, not data, and must be committed.
!apps/api/prisma/migrations/**/migration.sql
*.sql.gz
*.dump
*.backup
*.bak
dumps/
backups/
*.age

# Personal data exports (CSVs, spreadsheets, statements). Test fixtures live
# under tests/ and are re-included explicitly.
*.csv
*.xlsx
*.ofx
*.qif
!**/tests/**/*.csv

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/

# ─── Build output ────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# Astro / Vite / Vercel
.astro/
.vercel/
.vite/

# Prisma generated client (regenerated by `make install`)
**/generated/prisma/

# ─── Tests & coverage ────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
test-results/
playwright-report/

# ─── Logs & runtime ──────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.pid
*.seed
*.pid.lock

# Local Docker volumes (Postgres data, if bind-mounted)
.docker-data/
pgdata/
postgres-data/

# ─── Caches ──────────────────────────────────────────────────────────────────
.cache/
.eslintcache
.prettiercache
.stylelintcache
.turbo/
.tmp/
tmp/

# ─── Editors & OS ────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Windows "downloaded from internet" metadata (shows up on WSL)
*:Zone.Identifier

# ─── Claude Code (local, per-machine) ────────────────────────────────────────
.claude/settings.local.json
