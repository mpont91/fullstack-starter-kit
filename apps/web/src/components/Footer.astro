---
import { APP_NAME } from '@app/shared'
import { CONTACT_EMAIL } from '../constants'
import { localizePath } from '../helpers/locale-helper'
import { defaultLanguage, useTranslations, type Language } from '../i18n'

interface Props {
  lang?: Language
}

const { lang = defaultLanguage } = Astro.props

const t = useTranslations(lang)
const path = (to: string) => localizePath(to, lang)
const year = new Date().getFullYear()
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-2 px-4 py-6 text-sm text-muted sm:flex-row sm:px-6 lg:px-8">
    <p>
      © {year} {APP_NAME} — {t('footer.tagline')}
    </p>
    <nav class="flex items-center gap-4">
      <a
        href={path('/')}
        data-auth="out"
        class="transition hover:text-foreground"
      >
        {t('nav.home')}
      </a>
      {CONTACT_EMAIL && (
        <a href={path('/contact')} class="transition hover:text-foreground">
          {t('nav.contact')}
        </a>
      )}
      <a href={path('/privacy')} class="transition hover:text-foreground">
        {t('footer.privacy')}
      </a>
      <a href={path('/terms')} class="transition hover:text-foreground">
        {t('footer.terms')}
      </a>
    </nav>
  </div>
</footer>
