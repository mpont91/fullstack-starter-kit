---
export { getLanguagePaths as getStaticPaths } from '../../../helpers/locale-helper'
import Layout from '../../../layouts/Layout.astro'
import AppHome from '../../../components/AppHome.vue'
import { APP_NAME } from '@app/shared'
import { useTranslations } from '../../../i18n'
import { languageFromPath } from '../../../helpers/locale-helper'

const lang = languageFromPath(Astro.url.pathname)
const t = useTranslations(lang)
---

<Layout title={`${t('nav.dashboard')} · ${APP_NAME}`}>
  <AppHome client:only="vue" lang={lang} />
</Layout>
