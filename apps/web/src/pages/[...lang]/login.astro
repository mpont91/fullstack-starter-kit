---
export { getLanguagePaths as getStaticPaths } from '../../helpers/locale-helper'
import Layout from '../../layouts/Layout.astro'
import LoginForm from '../../components/LoginForm.vue'
import { APP_NAME } from '@app/shared'
import { useTranslations } from '../../i18n'
import { languageFromPath } from '../../helpers/locale-helper'

const lang = languageFromPath(Astro.url.pathname)
const t = useTranslations(lang)
---

<Layout title={`${t('login.title')} · ${APP_NAME}`} guestOnly>
  <div class="py-12 sm:py-20">
    <LoginForm client:load lang={lang} />
  </div>
</Layout>
