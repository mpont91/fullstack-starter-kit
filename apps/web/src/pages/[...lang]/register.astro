---
export { getLanguagePaths as getStaticPaths } from '../../helpers/locale-helper'
import Layout from '../../layouts/Layout.astro'
import RegisterForm from '../../components/RegisterForm.vue'
import { APP_NAME } from '@app/shared'
import { useTranslations } from '../../i18n'
import { languageFromPath } from '../../helpers/locale-helper'

const lang = languageFromPath(Astro.url.pathname)
const t = useTranslations(lang)
---

<Layout title={`${t('register.title')} · ${APP_NAME}`} guestOnly>
  <div class="py-12 sm:py-20">
    <RegisterForm client:load lang={lang} />
  </div>
</Layout>
